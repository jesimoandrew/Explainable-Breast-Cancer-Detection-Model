# Copy to .env and fill in from your Supabase project.
#   Dashboard -> Project Settings -> API
#
# SUPABASE_SERVICE_KEY is the *service_role* key. It bypasses Row Level Security,
# so it is read only by the FastAPI backend (app/db.py) and must never be put in
# frontend/ or committed. .env is gitignored.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

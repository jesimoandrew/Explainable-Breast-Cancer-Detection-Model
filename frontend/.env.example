# Copy to frontend/.env and fill in from Supabase -> Project Settings -> API.
#
# The ANON key belongs here: it is designed to be public, ships in the browser
# bundle, and is constrained by Row Level Security.
#
# NEVER put the service_role key in this file -- it bypasses RLS and would be
# served to every visitor. It belongs in the project-root .env, read only by the
# FastAPI backend.

VITE_SUPABASE_URL=https://swdudrnqgavlcqbvpypc.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
